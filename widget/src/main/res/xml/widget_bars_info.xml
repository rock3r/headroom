<?xml version="1.0" encoding="utf-8"?>
<!-- The app pushes every update, so the system never polls (updatePeriodMillis is 0). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_bars_description"
    android:initialLayout="@layout/widget_preview_bars"
    android:maxResizeHeight="180dp"
    android:maxResizeWidth="520dp"
    android:minHeight="40dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="180dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/widget_preview_bars"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen|keyguard" />
