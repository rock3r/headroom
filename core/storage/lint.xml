<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!--
        Room's DAOs, generated by KSP, call Room's restricted internals. The Android target marks
        that output as generated, so Lint skips it, but the JVM target (only there to run the tests
        on the host) does not. Its generated code is ignored for this one issue, and nowhere else.
    -->
    <issue id="RestrictedApi">
        <ignore regexp=".*/build/generated/ksp/jvm/.*" />
    </issue>
</lint>
