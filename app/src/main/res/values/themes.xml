<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window theme behind Compose: follows the system light or dark mode, no action bar. -->
    <style name="Theme.Headroom" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!--
        The glasses' window. Their display is additive: black is see-through, so the window starts
        black and nothing flashes before Compose draws.
    -->
    <style name="Theme.Headroom.Glasses" parent="Theme.Headroom">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
